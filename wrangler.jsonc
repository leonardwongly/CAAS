{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flight-route-explorer",
  "main": "apps/edge/src/index.ts",
  "compatibility_date": "2026-08-16",
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "containers": [
    {
      "name": "api",
      "class_name": "ApiContainer",
      "image": "./containers/Dockerfile",
      "image_build_context": ".",
      "instance_type": {
        "vcpu": 1,
        "memory_mib": 3072,
        "disk_mb": 2000
      },
      "max_instances": 1,
      "ssh": {
        "enabled": false
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API_CONTAINER",
        "class_name": "ApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ApiContainer"]
    }
  ],
  "secrets": {
    "required": ["apikey"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "env": {
    "staging": {
      "containers": [
        {
          "name": "api",
          "class_name": "ApiContainer",
          "image": "./containers/Dockerfile",
          "image_build_context": ".",
          "instance_type": {
            "vcpu": 1,
            "memory_mib": 3072,
            "disk_mb": 2000
          },
          "max_instances": 1,
          "ssh": {
            "enabled": false
          }
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "API_CONTAINER",
            "class_name": "ApiContainer"
          }
        ]
      },
      "secrets": {
        "required": ["apikey"]
      }
    }
  }
}
