{
  "name": "@flight-route-explorer/tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types *.test.ts route-safety/*.test.ts runtime-policies/*.test.ts upstream-bounds/*.test.ts synthesis/*.test.ts && pnpm run test:a11y && pnpm run test:e2e && pnpm run test:responsive",
    "test:upstream-bounds": "node --test --experimental-strip-types upstream-bounds/*.test.ts",
    "test:a11y": "vitest run --config vitest.config.ts a11y",
    "test:e2e": "vitest run --config vitest.config.ts e2e",
    "test:responsive": "vitest run --config vitest.config.ts responsive",
    "test:browser": "playwright test --config playwright.config.ts",
    "test:adversarial": "vitest run --config vitest.config.ts adversarial"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vitest": "^4.1.10"
  }
}
