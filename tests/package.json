{
  "name": "@flight-route-explorer/tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types *.test.ts route-safety/*.test.ts runtime-policies/*.test.ts upstream-bounds/*.test.ts",
    "test:upstream-bounds": "node --test --experimental-strip-types upstream-bounds/*.test.ts"
  }
}
